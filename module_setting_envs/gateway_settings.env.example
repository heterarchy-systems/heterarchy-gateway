# Explicit Gateway runtime and server settings. Copy to gateway_settings.env and set deployment values.
# Every key is required; use null only where the corresponding type permits None.
GATEWAY_FAILURE_SIMULATION_ENABLED='false'
GATEWAY_HTTP_TIMEOUT_SECONDS='10.0'
GATEWAY_MAX_CONNECTIONS='100'
GATEWAY_MAX_KEEPALIVE_CONNECTIONS='20'
GATEWAY_TRACE_CAPACITY='500'
GATEWAY_HOST='127.0.0.1'
GATEWAY_PORT='7979'
